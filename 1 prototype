<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Prototype</title>
    <style>
      body {
        margin: 0;
        font-family: Arial, sans-serif;
      }
    </style>
  </head>
  <body>
    <script>
      const jfAgentCacheName = 'dynamic-agent-v1';

      const sanitizeVariables = (rawUrl, rawWidth, rawHeight) => {
        try {
          const sanitizedUrl = new URL(rawUrl);
          const width = Number.parseInt(rawWidth, 10);
          const height = Number.parseInt(rawHeight, 10);

          return {
            url: sanitizedUrl.toString(),
            width: Number.isFinite(width) ? width : 0,
            height: Number.isFinite(height) ? height : 0
          };
        } catch (error) {
          console.error('Error sanitizing variables', error);
          return { url: '', width: 0, height: 0 };
        }
      };

      const copyStylesToPipWindow = (sourceDocument, pipWindow) => {
        [...sourceDocument.styleSheets].forEach(styleSheet => {
          try {
            const cssRules = [...styleSheet.cssRules]
              .map(rule => rule.cssText)
              .join('');

            const style = sourceDocument.createElement('style');
            style.textContent = cssRules;
            pipWindow.document.head.appendChild(style);
          } catch (error) {
            if (!styleSheet.href) {
              return;
            }

            const link = sourceDocument.createElement('link');
            link.rel = 'stylesheet';
            link.type = styleSheet.type || 'text/css';
            link.media = styleSheet.media || 'all';
            link.href = styleSheet.href;
            pipWindow.document.head.appendChild(link);
          }
        });
      };

      const handlePictureInPictureRequest = async event => {
        if (!event || !event.data || event.data.type !== 'jf-request-pip-window') {
          return;
        }

        const { _url, _width, _height } = event.data;
        const { url, width, height } = sanitizeVariables(_url, _width, _height);

        if (!url || width === 0 || height === 0) {
          return;
        }

        if (!('documentPictureInPicture' in window)) {
          return;
        }

        if (window.documentPictureInPicture.window) {
          return;
        }

        try {
          const pipWindow = await window.documentPictureInPicture.requestWindow({
            width,
            height,
            disallowReturnToOpener: true
          });

          copyStylesToPipWindow(document, pipWindow);

          const iframe = pipWindow.document.createElement('iframe');
          iframe.src = url;
          iframe.style.width = `${width}px`;
          iframe.style.height = `${height}px`;
          iframe.style.border = '0';
          iframe.setAttribute('allow', 'microphone *; display-capture *;');
          pipWindow.document.body.appendChild(iframe);

          return { success: true, isActive: false };
        } catch (error) {
          console.error('Error creating Picture-in-Picture window', error);
          return { success: false, isActive: false };
        }
      };

      window.addEventListener('message', handlePictureInPictureRequest);

      (async () => {
        const src = 'https://www.noupe.com/s/umd/637e10956ee/for-embedded-agent.js';
        const script = document.createElement('script');
        script.src = src;
        script.async = true;
        script.onload = function () {
          if (!window.AgentInitializer) {
            console.error('AgentInitializer is not available.');
            return;
          }

          window.AgentInitializer.init({
            agentRenderURL: 'https://www.noupe.com/agent/01a09aeb2d787000868b8061e04b8964f1fe',
            rootId: 'JotformAgent-01a09aeb2d787000868b8061e04b8964f1fe',
            formID: '01a09aeb2d787000868b8061e04b8964f1fe',
            contextID: '01a09af4ce5070018e7e2951ed6afdb02782',
            initialContext: '',
            queryParams: [
              'skipWelcome=1',
              'maximizable=1',
              'skipWelcome=1',
              'maximizable=1',
              'isNoupeAgent=1',
              'isNoupeLogo=0',
              'noupeSelectedColor=%230b1f3d',
              'B_VARIANT_AUTO_OPEN_NOUPE_CHATBOT_ON_PREVIEW=34462'
            ],
            domain: 'https://www.noupe.com',
            isDraggable: false,
            background: 'linear-gradient(180deg, #6C73A8 0%, #6C73A8 100%)',
            chatBackgroundColor: '#FFFFFF',
            buttonBackgroundColor: '#0066C3',
            buttonIconColor: '#FFFFFF',
            inputTextColor: '#01105C',
            variant: false,
            customizations: {
              greeting: 'Yes',
              greetingMessage: 'Hi! How can I assist you?',
              openByDefault: 'No',
              pulse: 'Yes',
              position: 'right',
              autoOpenChatIn: '0',
              layout: 'square'
            },
            isVoice: false,
            isVoiceWebCallEnabled: false
          });
        };

        document.head.appendChild(script);
      })();
    </script>
  </body>
</html>
